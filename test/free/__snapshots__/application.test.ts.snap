  {
    "description": "This server's own autonomy rules, not iCloud Mail's rules. Previews adding one; writes nothing. A rule runs every 15 minutes with nobody present. Show the user confirmationLine word for word, then commit with rules_commit.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "rule": {
          "additionalProperties": {},
          "description": "The rule to add. Pass the rule this returns back to rules_commit unaltered.",
          "properties": {
            "then": {
              "additionalProperties": {},
              "description": "What the rule does: flag, draft, or both.",
              "properties": {
                "draft": {
                  "additionalProperties": {},
                  "description": "A draft reply to each matching message's sender, in these words. Takes only text: no recipients, subject, copies or HTML. Never sent.",
                  "properties": {
                    "text": {
                      "description": "The reply's words, 1 to 2000 characters.",
                      "type": "string",
                    },
                  },
                  "type": "object",
                },
                "flag": {
                  "description": "true to flag each matching message.",
                  "type": "boolean",
                },
              },
              "type": "object",
            },
            "when": {
              "additionalProperties": {},
              "description": "What a new inbox message must match. Every kind given must match.",
              "properties": {
                "fromAddresses": {
                  "description": "Whole sender addresses, 1 to 10. Any one matches.",
                  "items": {
                    "type": "string",
                  },
                  "type": "array",
                },
                "fromDomains": {
                  "description": "Sender domains, 1 to 10. A subdomain matches too.",
                  "items": {
                    "type": "string",
                  },
                  "type": "array",
                },
                "subjectContains": {
                  "description": "Words in the subject, 1 to 10, each up to 100 characters. Any one matches.",
                  "items": {
                    "type": "string",
                  },
                  "type": "array",
                },
              },
              "type": "object",
            },
          },
          "required": [
            "when",
            "then",
          ],
          "type": "object",
        },
      },
      "required": [
        "rule",
      ],
      "type": "object",
