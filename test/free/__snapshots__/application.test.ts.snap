          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "changes_since",
  },
  {
    "description": "Fill your own recall index now, while you watch. Each call indexes up to 10 pages (25 messages each) of recent inbox and archive mail. Its time limit usually stops it after 4 or 5 pages. It says how far it got. Call it again until it says the index is built.",
    "inputSchema": {
      "properties": {},
      "type": "object",
    },
