{
  "name": "icloud-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server on Cloudflare Workers proxying iCloud Mail (IMAP), Calendar (CalDAV), and Contacts (CardDAV)",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "gen:hostname": "node scripts/write-hostname.mjs",
    "pretypecheck": "node scripts/write-hostname.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/write-hostname.mjs",
    "test": "vitest run --exclude test/probes.test.ts && npm run test:probes",
    "test:quick": "vitest run --reporter=dot --exclude test/probes.test.ts && npm run test:probes",
    "test:probes": "vitest run test/probes.test.ts",
    "predeploy": "node scripts/free-config.mjs",
    "deploy": "node scripts/free-deploy.mjs",
    "smoke": "node scripts/smoke-unauthenticated.mjs",
    "scan": "node scripts/forbidden-tokens.mjs",
    "docs:tools": "node scripts/tool-table.mjs --check",
    "prepare": "husky && node scripts/write-hostname.mjs",
    "build:free": "node scripts/free-deploy.mjs --dry-run",
    "prepare:free": "node scripts/free-config.mjs",
    "pretest:free": "node scripts/free-config.mjs",
    "test:free": "vitest run --config vitest.free.config.ts",
    "test:validation": "vitest run --config vitest.validation.config.ts",
    "check": "npm run typecheck && npm run scan && npm run docs:tools && npm test && npm run test:free && npm run test:validation",
    "bench:free": "node scripts/benchmark-free.mjs",
    "test:probe": "node scripts/test-cloud-probe.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "0.10.3",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.20.1",
    "aws4fetch": "1.0.20",
    "ical.js": "2.2.1",
    "postal-mime": "3.0.0",
    "tsdav": "2.3.4",
    "unpdf": "1.8.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.21.2",
    "@cloudflare/workers-types": "5.20260812.1",
    "@vitest/runner": "4.1.11",
    "@vitest/snapshot": "4.1.11",
    "husky": "9.1.7",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.122.0"
  },
  "overrides": {
    "undici": "7.29.1",
    "sharp": "0.35.4"
  }
}
